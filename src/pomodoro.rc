// pomodoro.rc - resource script
// Embeds the application manifest so the app uses Common Controls v6
// (modern visual styles) and declares DPI awareness.

#include <windows.h>
#include "resource.h"   // shared IDs (IDI_APPICON, IDD_SETTINGS, IDC_SET_*)

// Application icon. The lowest numeric ID becomes the icon Explorer shows for
// the .exe. We also load it by this ID at runtime for the window/taskbar.
IDI_APPICON ICON "..\\resources\\tomato.ico"

// 1 = CREATEPROCESS_MANIFEST_RESOURCE_ID (manifest for the .exe)
1 RT_MANIFEST "pomodoro.manifest"

// ---------------------------------------------------------------------------
// Settings dialog (IDs come from resource.h)
// ---------------------------------------------------------------------------
IDD_SETTINGS DIALOGEX 0, 0, 200, 96
STYLE DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Settings - Default Times"
FONT 9, "Segoe UI"
BEGIN
    LTEXT           "Default Work (minutes):", -1,            10, 12, 110, 10
    EDITTEXT        IDC_SET_WORK,                            130, 10,  50, 14, ES_NUMBER | ES_AUTOHSCROLL
    LTEXT           "Default Rest (minutes):", -1,            10, 34, 110, 10
    EDITTEXT        IDC_SET_REST,                            130, 32,  50, 14, ES_NUMBER | ES_AUTOHSCROLL
    DEFPUSHBUTTON   "OK",       IDOK,                         70, 68,  55, 16
    PUSHBUTTON      "Cancel",   IDCANCEL,                    132, 68,  55, 16
END
